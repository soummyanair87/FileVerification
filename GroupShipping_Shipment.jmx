            <stringProp name="script">UniqueId_1 = vars.get(&quot;UniqueId&quot;);
ShipmentId_1 = vars.get(&quot;ShipmentId&quot;);
TrackingNumber_1 = vars.get(&quot;TrackingNumber&quot;);
f = new FileOutputStream(&quot;${dir}/Confirm_Shipment_API_V4.csv&quot;, true);
p = new PrintStream(f);
this.interpreter.setOut(p);
print(UniqueId_1+&quot;,&quot;+ShipmentId_1+&quot;,&quot;+TrackingNumber_1);
f.close();</stringProp>
